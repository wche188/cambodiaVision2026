# Cambodia Vision — Environment Variables
# Copy this file to .env.local (development) or .env (production)

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cambodia_user
MYSQL_PASSWORD=your_secure_password_here
MYSQL_DATABASE=cambodia_vision
MYSQL_ROOT_PASSWORD=your_root_password_here

# Session Configuration
# Must be at least 32 characters for iron-session encryption
SESSION_SECRET=change_this_to_a_random_string_at_least_32_chars

# Application
NODE_ENV=production
